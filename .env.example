# Admin/CMS access. Required in production (Railway) so the admin API works over the network.
# Without it, the admin API is locked to localhost only. Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
DOWNLOAD_BASE_URL=http://127.0.0.1:8001
DATA_ROOT=

# Use Resend OR SMTP
RESEND_API_KEY=re_...
RESEND_FROM=academy@example.com

# Optional SMTP alternative
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: override default 72 hour download validity
DOWNLOAD_LINK_HOURS=72
